# Route @swamidasslab to GitHub Packages (public package).
# Auth is optional for the vendored file: install, but required to pull from
# the registry — yarn v1 errors if ${NPM_TOKEN} is referenced but unset, so
# set the token in the environment / user npmrc / CI instead of here:
#
#   export NPM_TOKEN=ghp_...   # classic PAT, read:packages
#   echo "//npm.pkg.github.com/:_authToken=${NPM_TOKEN}" >> ~/.npmrc
#
@swamidasslab:registry=https://npm.pkg.github.com
